# Jev / TypeSafe API key. As soon as it is set, the game uses Jev instead of the mock.
# (TYPESAFE_API_KEY works too.)
JEV_API_KEY=

# Optional overrides
# EVALUATOR=mock                 # force the mock even with a key ("mock" or "jev")
# JEV_MODEL=jev-1.13.0           # pinned version; avoid jev-latest once thresholds are tuned
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_TIMEOUT_S=5

# Comma-separated list of allowed frontend origins (local dev only)
CORS_ORIGINS=http://localhost:5173
