# Which evaluator to use: "mock" (default, no API needed) or "jev"
EVALUATOR=mock

# Jev / TypeSafe settings (only used when EVALUATOR=jev)
JEV_API_KEY=
JEV_API_URL=
# Pin a tested version rather than jev-latest
JEV_MODEL=jev-1.13.0

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
